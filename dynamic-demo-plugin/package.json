{
  "name": "@console/dynamic-demo-plugin",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build-webpack": "BUNDLER=webpack yarn ts-node node_modules/.bin/webpack",
    "build-rspack": "BUNDLER=rspack yarn ts-node node_modules/.bin/rspack -c webpack.config.ts",
    "build": "yarn clean && NODE_ENV=production yarn build-rspack && NODE_ENV=production yarn build-webpack",
    "build-dev": "yarn clean && yarn build-rspack && yarn build-webpack",
    "build-plugin-sdk": "yarn --cwd ../frontend/packages/console-dynamic-plugin-sdk build",
    "start-console": "./start-console.sh",
    "http-server": "./http-server.sh dist",
    "i18n": "i18next-cli lint && i18next-cli extract",
    "ts-node": "NODE_OPTIONS='--preserve-symlinks' ts-node -O '{\"module\":\"commonjs\"}'"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "portal:../frontend/packages/console-dynamic-plugin-sdk/dist/core",
    "@openshift-console/dynamic-plugin-sdk-webpack": "portal:../frontend/packages/console-dynamic-plugin-sdk/dist/webpack",
    "@patternfly/react-core": "^6.6.1",
    "@patternfly/react-icons": "^6.6.1",
    "@patternfly/react-table": "^6.6.1",
    "@rspack/cli": "^2.2.6",
    "@rspack/core": "^2.2.6",
    "@types/node": "^22.19.7",
    "@types/react": "^18.3.27",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^5.2.7",
    "file-loader": "6.2.0",
    "http-server": "^14.1.1",
    "i18next": "^25.8.18",
    "i18next-cli": "1.50.3",
    "js-yaml": "^4.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "~16.5.8",
    "react-router": "~7.18.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "webpack": "^5.100.0",
    "webpack-cli": "^7.2.3"
  },
  "consolePlugin": {
    "name": "console-demo-plugin",
    "version": "0.0.0",
    "displayName": "Console Demo Plugin",
    "description": "Plasma reactors online. Initiating hyper drive.",
    "exposedModules": {
      "K8sAPIConsumer": "./components/k8sConsumer/K8sAPIConsumer.tsx",
      "barUtils": "./utils/bar.ts",
      "clusterActivityOverview": "./components/ClusterOverview/Activity.tsx",
      "clusterInventoryOverview": "./components/ClusterOverview/Inventory.tsx",
      "clusterOverview": "./utils/cluster-overview.ts",
      "createProjectModal": "./components/Modals/CreateProjectModal.tsx",
      "customOverviewDetailItem": "./components/CustomOverviewDetailItem.tsx",
      "dashboardCard": "./components/DashboardCard.tsx",
      "events": "./components/APIServerEvents.tsx",
      "exampleNamespacedPage": "./components/ExampleNamespacedPage.tsx",
      "exampleNavs": "./utils/example-navs.tsx",
      "exampleProxyPage": "./components/ExampleProxyPage.tsx",
      "extensionConsumer": "./components/ExtensionConsumer.tsx",
      "health": "./components/health.ts",
      "listPage": "./components/ListPage.tsx",
      "modalPage": "./components/Modals/ModalPage.tsx",
      "navPage": "./components/Nav.tsx",
      "perspective": "./utils/perspective.ts",
      "projectOverview": "./utils/project-overview.ts",
      "projectOverviewInventory": "./components/ProjectOverview/Inventory.tsx",
      "projectTabContent": "./components/ProjectTabExtensionContent.tsx",
      "sampleErrorBoundaryPage": "./components/ErrorBoundary/SampleErrorBoundaryPage.tsx",
      "stubPages": "./components/stubPages.tsx",
      "telemetry": "./utils/telemetry.ts",
      "utilityConsumer": "./components/UtilityConsumer.tsx",
      "yamlEditor": "./components/YAMLEditorPage.tsx"
    }
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
