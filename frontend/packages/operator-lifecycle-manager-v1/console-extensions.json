[
  {
    "type": "console.flag/model",
    "properties": {
      "model": {
        "group": "olm.operatorframework.io",
        "version": "v1",
        "kind": "ClusterCatalog"
      },
      "flag": "CLUSTER_CATALOG_API"
    }
  },
  {
    "type": "console.flag/model",
    "properties": {
      "model": {
        "group": "olm.operatorframework.io",
        "version": "v1",
        "kind": "ClusterExtension"
      },
      "flag": "CLUSTER_EXTENSION_API"
    }
  },
  {
    "type": "console.flag/hookProvider",
    "properties": {
      "handler": {
        "$codeRef": "useInstalledOperatorsFlagProvider"
      }
    }
  },
  {
    "type": "console.catalog/item-type",
    "properties": {
      "type": "operator-olmv1",
      "title": "%olm-v1~Next-Gen Operators%",
      "catalogDescription": "%olm-v1~Browse for Operators managed by Next-Gen Operator Lifecycle Manager (OLMv1), a streamlined redesign that simplifies operator management with declarative APIs, enhanced security, and direct, GitOps-friendly control over upgrades.%",
      "typeDescription": "%olm-v1~**Operators** are software extensions to OpenShift that make use of custom resources to manage applications and their components. They are managed by Next-Gen Operator Lifecycle Manager (OLMv1).%",
      "filters": [
        {
          "label": "%olm-v1~Source%",
          "attribute": "source"
        },
        {
          "label": "%olm-v1~Provider%",
          "attribute": "provider"
        },
        {
          "label": "%olm-v1~Capability level%",
          "attribute": "capabilities"
        },
        {
          "label": "%olm-v1~Infrastructure features%",
          "attribute": "infrastructureFeatures"
        },
        {
          "label": "%olm-v1~Valid subscription%",
          "attribute": "validSubscription"
        }
      ]
    },
    "flags": {
      "required": ["CLUSTER_CATALOG_API", "TECH_PREVIEW"]
    }
  },
  {
    "type": "console.catalog/item-provider",
    "properties": {
      "catalogId": "dev-catalog",
      "type": "operator-olmv1",
      "title": "%olm-v1~Next-Gen Operators%",
      "provider": { "$codeRef": "useCatalogItems" }
    },
    "flags": {
      "required": ["CLUSTER_CATALOG_API", "TECH_PREVIEW"]
    }
  },
  {
    "type": "console.catalog/categories-provider",
    "properties": {
      "catalogId": "dev-catalog",
      "type": "operator-olmv1",
      "provider": { "$codeRef": "useCatalogCategories" }
    },
    "flags": {
      "required": ["CLUSTER_CATALOG_API", "TECH_PREVIEW"]
    }
  },
  {
    "type": "console.resource/create",
    "properties": {
      "model": {
        "group": "olm.operatorframework.io",
        "version": "v1",
        "kind": "ClusterExtension"
      },
      "component": {
        "$codeRef": "CreateClusterExtension"
      }
    },
    "flags": {
      "required": ["CLUSTER_EXTENSION_API"]
    }
  },
  {
    "type": "console.action/resource-provider",
    "properties": {
      "model": {
        "group": "olm.operatorframework.io",
        "version": "v1",
        "kind": "ClusterExtension"
      },
      "provider": { "$codeRef": "defaultActionsProvider.useDefaultActionsProvider" }
    },
    "flags": {
      "required": ["CLUSTER_EXTENSION_API"]
    }
  },
  {
    "type": "console.page/route",
    "properties": {
      "exact": false,
      "path": [
        "/installed-operators/all-namespaces",
        "/installed-operators/ns/:ns",
        "/installed-operators"
      ],
      "component": { "$codeRef": "installedOperatorsTabbedPage.default" }
    },
    "flags": {
      "required": ["INSTALLED_OPERATORS"]
    }
  },
  {
    "type": "console.page/route",
    "properties": {
      "exact": false,
      "path": [
        "/installed-software/all-namespaces",
        "/installed-software/ns/:ns",
        "/installed-software"
      ],
      "component": { "$codeRef": "installedSoftwareRedirect.default" }
    },
    "flags": {
      "required": ["CLUSTER_EXTENSION_API", "TECH_PREVIEW"]
    }
  }
]
