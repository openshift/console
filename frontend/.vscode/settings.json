{
  "oxc.enable": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/public/dist": true,
    "**/.yarn/releases/**": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/.cache-loader": true,
    "**/public/dist": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.hg/store/**": true,
    "**/public/dist": true
  },
  "editor.quickSuggestions": {
    "comments": "on",
    "strings": "on",
    "other": "on"
  },

  // js/ts settings
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.preferences.importModuleSpecifier": "project-relative",
  "js/ts.preferences.quoteStyle": "single",

  // json settings
  "files.associations": {
    "**/console-extensions.json": "jsonc",
    "**/*.md": "markdown"
  },
  "json.schemas": [
    {
      "fileMatch": ["**/console-extensions.json"],
      "url": "./packages/console-dynamic-plugin-sdk/dist/webpack/schema/console-extensions.json"
    }
  ],

  // unit test settings
  "jest.jestCommandLine": "yarn test",
  "jest.useJest30": true,
  "jest.runMode": "deferred", // Too many unit tests to run the entire suite automatically

  // seperate blocks are higher priority than a single block with multiple languages
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.format.oxc": "always", // run formatter first
      "source.fixAll.oxc": "always" // run lint fixes after
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.format.oxc": "always", // run formatter first
      "source.fixAll.oxc": "always" // run lint fixes after
    }
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  }
}
