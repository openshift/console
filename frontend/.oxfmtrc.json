{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".yarn",
    "node_modules",
    "public/dist",
    "**/locales",
    "__nock-fixtures__",
    "**/generated"
  ]
}
