# Upstream source the image is built from. release-coo-ocp-4.22 is the Cluster
# Observability Operator line for OpenShift 4.22 and later, the newest release
# branch (console 5.0 has no logging-view-plugin branch of its own). It is main
# plus dependency fixes and builds against @openshift-console/dynamic-plugin-sdk
# 4.22, which console 5.0 still loads. Bump UPSTREAM_COMMIT to the branch tip
# when rebasing, then check that patches/ still applies.
UPSTREAM_REPO=https://github.com/openshift/logging-view-plugin.git
UPSTREAM_BRANCH=release-coo-ocp-4.22
UPSTREAM_COMMIT=bad397e2e648009af380a48f7b48e171f7b9efc3
