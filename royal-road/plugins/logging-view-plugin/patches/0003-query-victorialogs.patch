+// VictoriaLogs' query API (https://docs.victoriametrics.com/victorialogs/querying/),
+// reached through the tenancy proxy at `${endpoint}/select/logsql/...`. The
+// responses are converted to the Loki shapes the rest of the plugin renders.
+
+// Label and series lookups have no time range in the UI; look at the last 6
+// hours, as Loki does by default.
+const LOOKUP_RANGE_NS = 21_600_000_000_000n;
+
+// VictoriaLogs takes Unix timestamps with up to nanosecond fractions.
+export const nsToVLTime = (ns: string | bigint): string => {
+  const value = BigInt(ns);
+  const seconds = value / 1_000_000_000n;
+  const fraction = value % 1_000_000_000n;
+  return `${seconds}.${String(fraction).padStart(9, '0')}`;
+};
+
+const lookupStart = () => nsToVLTime(BigInt(Date.now()) * 1_000_000n - LOOKUP_RANGE_NS);
+
+// RFC 3339 with up to nanosecond precision, as in VictoriaLogs' _time field.
+export const vlTimeToNs = (time: string): string => {
+  const match = time.match(/^(.*?)(?:\.(\d+))?(Z|[+-]\d\d:\d\d)$/);
+  if (!match) {
+    return String(BigInt(Date.parse(time)) * 1_000_000n);
+  }
+  const [, base, fraction = '', zone] = match;
+  const ms = Date.parse(`${base}${zone}`);
+  return String(BigInt(ms) * 1_000_000n + BigInt(fraction.padEnd(9, '0').slice(0, 9)));
+};
+
+const VL_INTERNAL_FIELDS = ['_msg', '_time', '_stream', '_stream_id'];
+
+// One stream per log line keeps VictoriaLogs' ordering in the table.
+export const logLinesToStreams = (text: string, direction?: Direction): StreamsResult => {
+  const entries = text
+    .split('\n')
+    .filter((line) => line.trim().length > 0)
+    .map((line) => JSON.parse(line) as Record<string, string>)
+    .map((entry) => {
+      const stream: Record<string, string> = {};
+      for (const [key, value] of Object.entries(entry)) {
+        if (!VL_INTERNAL_FIELDS.includes(key)) {
+          stream[key] = String(value);
+        }
+      }
+      return { ns: vlTimeToNs(entry._time ?? ''), msg: entry._msg ?? '', stream };
+    });
+
+  entries.sort((a, b) => {
+    const diff = BigInt(a.ns) - BigInt(b.ns);
+    const order = diff === 0n ? 0 : diff > 0n ? 1 : -1;
+    return direction === 'forward' ? order : -order;
+  });
+
+  return {
+    resultType: 'streams',
+    result: entries.map(({ ns, msg, stream }) => ({ stream, values: [[ns, msg]] })),
+  };
+};
+
+type HitsResponse = {
+  hits?: Array<{
+    fields: Record<string, string>;
+    timestamps: Array<string>;
+    values: Array<number>;
+  }>;
+};
+
+export const hitsToMatrix = (response: HitsResponse): QueryRangeResponse<MatrixResult> => ({
+  status: 'success',
+  data: {
+    resultType: 'matrix',
+    stats: {},
+    result: (response.hits ?? []).map(({ fields, timestamps, values }) => ({
+      metric: fields,
+      values: timestamps.map((time, i) => [Date.parse(time) / 1000, String(values[i])]),
+    })),
+  },
+});
+
+// Parses `{a="b",c="d"}` as VictoriaLogs returns stream labels.
+export const parseStreamLabels = (stream: string): Record<string, string> => {
+  const labels: Record<string, string> = {};
+  for (const match of stream.matchAll(/([^{}=,\s]+)="((?:[^"\\]|\\.)*)"/g)) {
+    labels[match[1]] = JSON.parse(`"${match[2]}"`);
+  }
+  return labels;
+};
+
+const mapFetch = <T, U>(fetch: CancellableFetch<T>, map: (value: T) => U): CancellableFetch<U> => ({
+  request: () => fetch.request().then(map),
+  abort: fetch.abort,
+});
+
+// Duration in VictoriaLogs syntax ("1h5m"), at least one second.
+const stepFromMs = (ms: number) => durationFromTimestamp(Math.max(1000, ms)).replace(/\s+/g, '');
