+jest.mock('@openshift-console/dynamic-plugin-sdk', () => ({
+  consoleFetch: jest.fn(),
+  consoleFetchJSON: jest.fn(),
+}));
+
+import {
+  hitsToMatrix,
+  logLinesToStreams,
+  nsToVLTime,
+  parseStreamLabels,
+  vlTimeToNs,
+} from '../loki-client';
+
+describe('VictoriaLogs responses', () => {
+  it('converts timestamps without losing nanoseconds', () => {
+    expect(nsToVLTime('1794699000123456789')).toEqual('1794699000.123456789');
+    expect(vlTimeToNs('2026-11-14T23:31:04.476174903Z')).toEqual('1794699064476174903');
+    expect(vlTimeToNs('2026-11-14T23:31:04Z')).toEqual('1794699064000000000');
+  });
+
+  it('turns JSON lines into one stream per line, newest first', () => {
+    const text = [
+      '{"_msg":"old","_time":"2026-11-14T23:31:04Z","_stream":"{}","namespace":"a","level":"INFO"}',
+      '{"_msg":"new","_time":"2026-11-14T23:31:05Z","_stream_id":"1","namespace":"a"}',
+      '',
+    ].join('\n');
+    const result = logLinesToStreams(text, 'backward');
+    expect(result.result).toEqual([
+      { stream: { namespace: 'a' }, values: [['1794699065000000000', 'new']] },
+      { stream: { namespace: 'a', level: 'INFO' }, values: [['1794699064000000000', 'old']] },
+    ]);
+    expect(logLinesToStreams(text, 'forward').result[0].values[0][1]).toEqual('old');
+  });
+
+  it('turns hits into a matrix', () => {
+    expect(
+      hitsToMatrix({
+        hits: [{ fields: { level: 'ERR' }, timestamps: ['2026-11-14T22:33:00Z'], values: [3] }],
+      }).data.result,
+    ).toEqual([{ metric: { level: 'ERR' }, values: [[1794695580, '3']] }]);
+  });
+
+  it('parses stream labels', () => {
+    expect(parseStreamLabels('{container="web",namespace="team-a",msg="a \\"q\\""}')).toEqual({
+      container: 'web',
+      namespace: 'team-a',
+      msg: 'a "q"',
+    });
+  });
+});
