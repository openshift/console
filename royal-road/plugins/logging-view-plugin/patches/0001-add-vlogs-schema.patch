     case Schema.viaq:
     case SchemaConfig.viaq:
       return Schema.viaq;
+    case Schema.vlogs:
+    case SchemaConfig.vlogs:
+      return Schema.vlogs;
 
     default:
       return DEFAULT_SCHEMA;
