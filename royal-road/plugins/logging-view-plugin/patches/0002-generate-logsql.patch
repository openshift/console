+export const quoteLogsQL = (value: string) => JSON.stringify(value);
+
+const REGEX_SPECIAL_CHARS = /[.*+?^${}()|[\]\\]/g;
+export const escapeRegex = (value: string) => value.replace(REGEX_SPECIAL_CHARS, '\\$&');
