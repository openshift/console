new file mode 100644
index 0000000..ba7ea4c
--- /dev/null
+++ b/web/src/logsql-query.ts
@@ -0,0 +1,217 @@
+// A small model of the VictoriaLogs LogsQL queries this plugin builds:
+//
+//   { namespace="a", pod=~"b|c" } <other filters> <content filter> <level filter> | <pipes>
+//
+// It parses the stream selector into label matchers, keeps every other top-level
+// filter verbatim, recognises the content and level filters the plugin writes,
+// and leaves the pipes after the first top-level `|` untouched.
+// See https://docs.victoriametrics.com/victorialogs/logsql/
+
+export type LabelMatcher = {
+  label?: string;
+  operator?: string;
+  value?: string;
+};
+
+export type LogsQLFilterKind = 'content' | 'level' | 'other';
+
+export type LogsQLFilter = {
+  kind: LogsQLFilterKind;
+  // the filter as written in the query
+  text: string;
+};
+
+export const LEVEL_FIELD = 'level';
+
+const LABEL = /([A-Za-z_][\w.]*|"(?:[^"\\]|\\.)*")/.source;
+const OPERATOR = /(=~|!~|!=|=|not_in|in)/.source;
+const VALUE = /("(?:[^"\\]|\\.)*"|`[^`]*`|\([^)]*\))/.source;
+const MATCHER_REGEX = new RegExp(`\\s*${LABEL}\\s*${OPERATOR}\\s*${VALUE}\\s*,?`, 'y');
+
+// Splits `text` at top-level whitespace, keeping quoted strings and parenthesised
+// groups together. Stops at the first top-level `|` and returns the rest as pipes.
+const tokenize = (text: string): { tokens: Array<string>; pipes: string } => {
+  const tokens: Array<string> = [];
+  let current = '';
+  let depth = 0;
+  let quote: string | undefined;
+
+  for (let i = 0; i < text.length; i++) {
+    const char = text[i];
+
+    if (quote) {
+      current += char;
+      if (char === '\\' && quote !== '`' && i + 1 < text.length) {
+        current += text[++i];
+      } else if (char === quote) {
+        quote = undefined;
+      }
+      continue;
+    }
+
+    if (char === '"' || char === "'" || char === '`') {
+      quote = char;
+      current += char;
+    } else if (char === '(' || char === '{') {
+      depth++;
+      current += char;
+    } else if (char === ')' || char === '}') {
+      depth = Math.max(0, depth - 1);
+      current += char;
+    } else if (depth === 0 && char === '|') {
+      if (current) tokens.push(current);
+      return { tokens, pipes: text.slice(i + 1).trim() };
+    } else if (depth === 0 && /\s/.test(char)) {
+      if (current) tokens.push(current);
+      current = '';
+    } else {
+      current += char;
+    }
+  }
+
+  if (current) tokens.push(current);
+
+  return { tokens, pipes: '' };
+};
+
+const parseSelector = (selector: string): Array<LabelMatcher> => {
+  const body = selector
+    .replace(/^_stream:/, '')
+    .trim()
+    .slice(1, -1);
+  const matchers: Array<LabelMatcher> = [];
+  MATCHER_REGEX.lastIndex = 0;
+  let match: RegExpExecArray | null;
+
+  while (MATCHER_REGEX.lastIndex < body.length && (match = MATCHER_REGEX.exec(body)) !== null) {
+    matchers.push({ label: match[1], operator: match[2], value: match[3] });
+  }
+
+  return matchers;
+};
+
+const isSelector = (token: string) => /^(_stream:)?\{.*\}$/s.test(token);
+
+const filterKind = (token: string): LogsQLFilterKind => {
+  if (token.startsWith(`${LEVEL_FIELD}:`)) {
+    return 'level';
+  }
+  if (/^\*(".*"|[^\s"*]+)\*$/s.test(token)) {
+    return 'content';
+  }
+  return 'other';
+};
+
+export const matcherToString = ({ label, operator, value }: LabelMatcher) =>
+  `${label}${operator !== undefined ? operator : ''}${value !== undefined ? value : ''}`;
+
+export class LogsQLQuery {
+  streamSelector: Array<LabelMatcher> = [];
+  // every stream selector in the query, including the first one
+  streamSelectors: Array<Array<LabelMatcher>> = [];
+  filters: Array<LogsQLFilter> = [];
+  pipes = '';
+
+  constructor(query: string) {
+    const { tokens, pipes } = tokenize(query.trim());
+    // With a top-level `or` no single selector applies to the whole query, so
+    // none is taken out for editing; the filters are kept as written.
+    const hasTopLevelOr = tokens.some((token) => token.toLowerCase() === 'or');
+
+    for (const token of tokens) {
+      if (isSelector(token)) {
+        this.streamSelectors.push(parseSelector(token));
+        if (this.streamSelectors.length === 1 && !hasTopLevelOr) {
+          this.streamSelector = this.streamSelectors[0];
+          continue;
+        }
+      }
+      if (token === '*') {
+        continue;
+      }
+      this.filters.push({ kind: filterKind(token), text: token });
+    }
+
+    this.pipes = pipes;
+  }
+
+  removeSelectorMatcher = (matcherToRemove: Partial<LabelMatcher>) => {
+    this.streamSelector = this.streamSelector.filter(
+      (matcher) => !matcherToRemove.label || matcher.label !== matcherToRemove.label,
+    );
+
+    return this;
+  };
+
+  addSelectorMatcher = (matchers?: LabelMatcher | Array<LabelMatcher>) => {
+    if (!matchers) {
+      return this;
+    }
+
+    const matchersArray = Array.isArray(matchers) ? matchers : [matchers];
+
+    matchersArray.forEach((matcher) => {
+      const existingSelectorIndex = this.streamSelector.findIndex(
+        ({ label }) => matcher.label === label,
+      );
+
+      if (existingSelectorIndex !== -1) {
+        this.streamSelector[existingSelectorIndex] = matcher;
+      } else {
+        this.streamSelector.push(matcher);
+      }
+    });
+
+    return this;
+  };
+
+  getFilter = (kind: LogsQLFilterKind): LogsQLFilter | undefined =>
+    this.filters.find((filter) => filter.kind === kind);
+
+  // Replaces the filter of `kind` (content or level) with `text`, or removes it
+  // when `text` is undefined.
+  setFilter = (kind: Exclude<LogsQLFilterKind, 'other'>, text?: string) => {
+    this.filters = this.filters.filter((filter) => filter.kind !== kind);
+
+    if (text) {
+      this.filters.push({ kind, text });
+    }
+
+    return this;
+  };
+
+  hasStatsPipe = () => /(^|\|)\s*stats\b/.test(this.pipes);
+
+  toString = () => {
+    const parts: Array<string> = [];
+
+    if (this.streamSelector.length > 0) {
+      parts.push(`{ ${this.streamSelector.map(matcherToString).join(', ')} }`);
+    }
+
+    const others = this.filters.filter(({ kind }) => kind === 'other').map(({ text }) => text);
+    // `a or b` binds looser than the implicit AND between filters, so group the
+    // user's own filters before adding ours.
+    const hasTopLevelOr = others.some((text) => text.toLowerCase() === 'or');
+    if (others.length > 0) {
+      parts.push(hasTopLevelOr ? `(${others.join(' ')})` : others.join(' '));
+    }
+
+    for (const kind of ['content', 'level'] as const) {
+      const filter = this.getFilter(kind);
+      if (filter) {
+        parts.push(filter.text);
+      }
+    }
+
+    const query = parts.length > 0 ? parts.join(' ') : '*';
+
+    return this.pipes ? `${query} | ${this.pipes}` : query;
+  };
+}
