+import { LogsQLQuery } from '../logsql-query';
+
+describe('LogsQLQuery', () => {
+  it('parses the stream selector, filters and pipes', () => {
+    const query = new LogsQLQuery(
+      '_stream:{namespace="a", pod=~"b|c", container in ("x","y")} error *"t i"* level:~"(?i)^(err)$" | stats by (level) count()',
+    );
+    expect(query.streamSelector).toEqual([
+      { label: 'namespace', operator: '=', value: '"a"' },
+      { label: 'pod', operator: '=~', value: '"b|c"' },
+      { label: 'container', operator: 'in', value: '("x","y")' },
+    ]);
+    expect(query.filters.map(({ kind }) => kind)).toEqual(['other', 'content', 'level']);
+    expect(query.pipes).toEqual('stats by (level) count()');
+    expect(query.hasStatsPipe()).toBe(true);
+  });
+
+  it('keeps a | inside quotes and parentheses', () => {
+    const query = new LogsQLQuery('"a | b" (x or y) | limit 5');
+    expect(query.filters.map(({ text }) => text)).toEqual(['"a | b"', '(x or y)']);
+    expect(query.pipes).toEqual('limit 5');
+    expect(query.hasStatsPipe()).toBe(false);
+  });
+
+  it('round-trips a query and collects every selector', () => {
+    const query = new LogsQLQuery('{ namespace="a" } or { namespace="b" }');
+    expect(query.streamSelectors).toHaveLength(2);
+    expect(query.streamSelector).toEqual([]);
+    expect(query.toString()).toEqual('({ namespace="a" } or { namespace="b" })');
+    expect(new LogsQLQuery('').toString()).toEqual('*');
+  });
+});
