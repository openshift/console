diff --git a/src/consts.ts b/src/consts.ts
index 110c36e..87dd65c 100644
--- a/src/consts.ts
+++ b/src/consts.ts
@@ -172,7 +172,15 @@ export const FLAG_OPENSHIFT_PIPELINE_AS_CODE = 'OPENSHIFT_PIPELINE_AS_CODE';
 export const FLAG_OPENSHIFT_PIPELINE_APPROVAL_TASK =
   'OPENSHIFT_PIPELINE_APPROVAL_TASK';
 export const PAC_INFO = 'pipelines-as-code-info';
-export const PIPELINE_NAMESPACE = 'openshift-pipelines';
+// Namespace OpenShift Pipelines is installed in (Pipelines-as-Code secret and
+// configuration). Override with the PIPELINE_NAMESPACE build-time variable.
+export const PIPELINE_NAMESPACE =
+  process.env.PIPELINE_NAMESPACE || 'openshift-pipelines';
+// Namespace whose Tasks the pipeline builder offers through the cluster
+// resolver, and the default namespace of cluster resolver references without
+// one. Override with the CLUSTER_RESOLVER_TASK_NAMESPACE build-time variable.
+export const CLUSTER_RESOLVER_TASK_NAMESPACE =
+  process.env.CLUSTER_RESOLVER_TASK_NAMESPACE || PIPELINE_NAMESPACE;
 export const PIPELINERUN_TEMPLATE_NAMESPACE = 'openshift';
 export const PAC_TEMPLATE_DEFAULT = 'pipelines-as-code-pipelinerun-generic';
 
