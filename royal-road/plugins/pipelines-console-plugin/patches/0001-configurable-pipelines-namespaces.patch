+import { CLUSTER_RESOLVER_TASK_NAMESPACE } from '../../consts';
 import { TaskModel } from '../../models';
 import { PipelineTask, TaskKind } from '../../types';
 import { AddNodeDirection } from '../pipeline-topology/const';
@@ -63,7 +63,7 @@ export const useFormikFetchAndSaveTasks = (
     clusterResolverTasks: {
       kind: getReferenceForModel(TaskModel),
       isList: true,
-      namespace: PIPELINE_NAMESPACE,
+      namespace: CLUSTER_RESOLVER_TASK_NAMESPACE,
