     taskRef = {
       resolver: 'cluster',
       params: [
         { name: 'kind', value: 'task' },
         { name: 'name', value: resource.metadata.name },
-        { name: 'namespace', value: PIPELINE_NAMESPACE },
+        { name: 'namespace', value: CLUSTER_RESOLVER_TASK_NAMESPACE },
       ],
     };
   } else {
