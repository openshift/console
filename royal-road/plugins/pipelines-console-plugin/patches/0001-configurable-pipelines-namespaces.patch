   const namespacedTaskData = namespacedTasks.loaded
diff --git a/src/components/pipeline-builder/utils.ts b/src/components/pipeline-builder/utils.ts
index 35b1b1d..cba3560 100644
--- a/src/components/pipeline-builder/utils.ts
+++ b/src/components/pipeline-builder/utils.ts
@@ -7,8 +7,8 @@ import {
 import { FormikErrors } from 'formik';
 import * as _ from 'lodash';
 import {
+  CLUSTER_RESOLVER_TASK_NAMESPACE,
   DEFAULT_WORKSPACE_ANNOTATION,
-  PIPELINE_NAMESPACE,
   VolumeTypes,
 } from '../../consts';
 import { PipelineModel, TaskModel } from '../../models';
@@ -369,15 +369,15 @@ export const convertResourceToTask = (
   const kind = resource.kind ?? TaskModel.kind;
   let taskRef;
   if (
-    resource.metadata.namespace === PIPELINE_NAMESPACE &&
-    namespace !== PIPELINE_NAMESPACE
+    resource.metadata.namespace === CLUSTER_RESOLVER_TASK_NAMESPACE &&
+    namespace !== CLUSTER_RESOLVER_TASK_NAMESPACE
