# Upstream source the image is built from. openshift/lightspeed-console has no
# release branches or tags for console 5.0: `main` is the build for console
# 4.22+ (SDK 4.22, `@console/pluginAPI >=4.22`), and upstream's own image serves
# it for OCP_VERSION 5.0. Bump UPSTREAM_COMMIT to the main tip, then re-run the
# kind check in royal-road/deploy/lightspeed/README.md.
UPSTREAM_REPO=https://github.com/openshift/lightspeed-console.git
UPSTREAM_BRANCH=main
UPSTREAM_COMMIT=dfd23ac25796b190ac7a9837a17cf016fe7983a4
